# Required: generate with: openssl rand -hex 32
SCONNECT_ADMIN_TOKEN=replace-with-at-least-32-random-hex-characters

# Public DNS name or IP used in the generated ICE server URLs.
TURN_PUBLIC_HOST=turn.example.com

# Public IP of the server. For cloud NAT, use PUBLIC_IP/PRIVATE_IP.
TURN_EXTERNAL_IP=203.0.113.10
TURN_LISTEN_IP=0.0.0.0
TURN_RELAY_IP=

# Management API stays on loopback. Use an SSH tunnel or a reverse proxy.
SCONNECT_BIND=127.0.0.1
SCONNECT_PORT=8080
SCONNECT_MAX_ACCOUNTS=20
SCONNECT_USAGE_POLL_SECONDS=5

# Port layout for 20 accounts. Keep these ranges disjoint.
TURN_PORT_BASE=34780
TURN_TLS_PORT_BASE=54000
TURN_RELAY_PORT_BASE=50000
TURN_RELAY_PORTS_PER_ACCOUNT=64
TURN_METRICS_PORT_BASE=39100
TURN_CLI_PORT_BASE=39000

# Optional TURN over TLS/DTLS. Mount certificates at ./certs.
TURN_TLS_ENABLED=false
TURN_TLS_CERT=/certs/fullchain.pem
TURN_TLS_KEY=/certs/privkey.pem

# Keep these false unless TURN clients must reach private or loopback peers.
TURN_ALLOW_PRIVATE_PEERS=false
TURN_ALLOW_LOOPBACK_PEERS=false

# Optional TLS for the management API itself.
SCONNECT_API_TLS_CERT=
SCONNECT_API_TLS_KEY=

COTURN_IMAGE=coturn/coturn:4.18.0-r0-debian
